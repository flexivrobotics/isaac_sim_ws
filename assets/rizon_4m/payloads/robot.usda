#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "rizon_4m"
    doc = """Generated from Composed Stage of root layer Flexiv/rizon_4m/rizon_4m.usd/rizon_4m.usda
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "rizon_4m" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </rizon_4m/Physics/root_joint>,
        </rizon_4m/Physics/joint1>,
        </rizon_4m/Physics/joint2>,
        </rizon_4m/Physics/joint3>,
        </rizon_4m/Physics/joint4>,
        </rizon_4m/Physics/joint5>,
        </rizon_4m/Physics/joint6>,
        </rizon_4m/Physics/joint7>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </rizon_4m/Geometry/base_link>,
        </rizon_4m/Geometry/base_link/link1>,
        </rizon_4m/Geometry/base_link/link1/link2>,
        </rizon_4m/Geometry/base_link/link1/link2/link3>,
        </rizon_4m/Geometry/base_link/link1/link2/link3/link4>,
        </rizon_4m/Geometry/base_link/link1/link2/link3/link4/link5>,
        </rizon_4m/Geometry/base_link/link1/link2/link3/link4/link5/link6>,
        </rizon_4m/Geometry/base_link/link1/link2/link3/link4/link5/link6/link7>,
        </rizon_4m/Geometry/base_link/link1/link2/link3/link4/link5/link6/link7/flange>,
    ]
    token isaac:robotType = "Manipulator"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "link6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "link7" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "flange" (
                                            prepend apiSchemas = ["IsaacSiteAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint6" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

