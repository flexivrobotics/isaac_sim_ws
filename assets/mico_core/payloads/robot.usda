        </mico_core/Physics/system1_left_arm_joint7>,
        </mico_core/Physics/system1_right_arm_joint1>,
        </mico_core/Physics/system1_right_arm_joint2>,
        </mico_core/Physics/system1_right_arm_joint3>,
        </mico_core/Physics/system1_right_arm_joint4>,
