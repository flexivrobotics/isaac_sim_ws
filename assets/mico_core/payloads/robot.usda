#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "mico_core"
    doc = """Generated from Composed Stage of root layer Flexiv/mico_core/mico_core.usd/mico_core.usda
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mico_core" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </mico_core/Physics/system1_system_mount_joint>,
        </mico_core/Physics/system1_left_arm_joint1>,
